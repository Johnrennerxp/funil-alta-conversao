rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite acesso administrativo para o Proprietário Master (Google) e usuários autenticados
    function isAuthenticated() {
      return request.auth != null;
    }

    // Coleção de usuários autorizados / clientes licenciados
    match /authorized_users/{email} {
      allow read, write: if isAuthenticated();
    }

    // Formulários públicos (visitantes lêem para responder; autenticados criam e editam)
    match /public_forms/{formId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Registro anônimo de acessos e conversão
    match /form_analytics/{analyticsId} {
      allow create: if true;
      allow read, delete: if isAuthenticated();
      allow update: if false;
    }

    // Respostas dos leads para geração de planilha
    match /form_submissions/{submissionId} {
      allow create: if true;
      allow read, delete: if isAuthenticated();
      allow update: if false;
    }
  }
}
