rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper para verificar se o usuário autenticado é admin autorizado
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email_verified == true 
        && exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email));
    }

    // Coleção de usuários autorizados: o ID do documento é o próprio e-mail
    match /authorized_users/{email} {
      allow read, write: if isAdmin();
    }

    // Formulários públicos criados no sistema
    match /public_forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registro anônimo de métricas e analytics de conversão
    match /form_analytics/{analyticsId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Respostas e Leads submetidos pelos formulários (Planilha de Respostas)
    // Permite que visitantes enviem suas respostas de forma segura (create: true)
    // Apenas admins autorizados podem ler, baixar a planilha ou excluir (read, delete: if isAdmin())
    // Atualização bloqueada para preservar integridade histórica dos dados (update: false)
    match /form_submissions/{submissionId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
