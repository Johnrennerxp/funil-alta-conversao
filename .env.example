# Configurações do Firebase (Plano Spark - 100% Gratuito)
# Obtenha estas credenciais no Firebase Console > Configurações do Projeto > Geral > Seus apps
# NUNCA insira valores reais neste arquivo nem comite o arquivo .env no Git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
